    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "^7.3.2",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.12",
    "oxlint": "^1.81.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
