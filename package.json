{
  "name": "personal-homepage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run content:prepare && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "content:prepare": "node scripts/prepare-content.mjs",
