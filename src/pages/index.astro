---
import BaseLayout from '../layouts/BaseLayout.astro'
import ActivityHeatmap from '../components/ActivityHeatmap.astro'
import StickerPlayground from '../components/StickerPlayground.jsx'
import { siteConfig, withBase } from '../config/site.js'
import activity from '../data/activity-cache.json'
import { getGallery, getNotes, getProjects } from '../lib/content'
import type { ActivityCache } from '../types/activity'
import fallbackSticker from '../assets/hero.png'

const activityData = activity as ActivityCache
const notes = (await getNotes()).slice(0, 3)
const projects = await getProjects()
const gallery = await getGallery()
const stickerItems = gallery.filter((photo) => photo.featured && photo.sticker).slice(0, 6).map((photo) => ({
  id: photo.id, title: photo.title, alt: photo.alt, src: withBase(photo.sticker), shape: photo.shape,
}))
if (stickerItems.length === 0) stickerItems.push({ id: 'hello', title: 'A small hello', alt: 'A portrait sticker', src: fallbackSticker.src, shape: [] })
---

<BaseLayout>
  <section class="hero shell">
    <div>
      <p class="eyebrow">PolyU · Information Technology · Shenzhen / Hong Kong</p>
      <h1>Learning to build things that <em>think.</em></h1>
      <p class="lead">I am an IT student exploring the space between dependable software systems and curious, capable AI agents.</p>
      <div class="hero-actions">
        <a class="button-primary" href="#craft">Explore my work ↓</a>
        <a class="text-link" href={`mailto:${siteConfig.email}`}>{siteConfig.email} ↗</a>
      </div>
    </div>
    <div class="hero-orbit" aria-label="Abstract visual representing connected systems">
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div>
      <div class="orbit-core">curiosity<br />→ practice</div>
      <span class="orbit-label">learn</span><span class="orbit-label">build</span><span class="orbit-label">reflect</span>
    </div>
  </section>

  <section id="about" class="band section">
    <div class="shell section-grid">
      <p class="eyebrow">01 / About</p>
      <div>
        <h2 class="section-title">A work in progress,<br /><em>on purpose.</em></h2>
        <p class="body-large">I am currently studying Information Technology at The Hong Kong Polytechnic University. Before that, I completed my bachelor's degree at China University of Geosciences (Wuhan).</p>
        <p class="body-copy">I do not have every next step figured out yet. For now, I am choosing the honest route: stay curious, take small steps, and keep making the distance between an idea and a working system shorter.</p>
      </div>
    </div>
  </section>

  <section id="craft" class="section shell">
    <div class="section-heading"><div><p class="eyebrow">02 / What I work on</p><h2>From foundations<br /><em>to frontier ideas.</em></h2></div></div>
    <div class="card-grid">
      <article class="skill-card"><span class="number">01</span><h3>Backend systems</h3><p>Building a practical foundation with Java, SpringBoot, Redis, MySQL, PostgreSQL, and Kafka.</p><div class="tags"><span class="tag">Java</span><span class="tag">SpringBoot</span><span class="tag">Data</span></div></article>
      <article class="skill-card"><span class="number">02</span><h3>Machine intelligence</h3><p>My undergraduate work introduced me to deep learning across computer vision and natural language processing.</p><div class="tags"><span class="tag">Computer vision</span><span class="tag">NLP</span></div></article>
      <article class="skill-card"><span class="number">03</span><h3>Agentic tools</h3><p>Exploring MCP, skills, CLI workflows, ReAct, and both naive RAG and GraphRAG while building a learning platform.</p><div class="tags"><span class="tag">MCP</span><span class="tag">RAG</span><span class="tag">ReAct</span></div></article>
    </div>
  </section>

  {projects.length > 0 && <section class="band section">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">03 / Selected projects</p><h2>Things made<br /><em>with intent.</em></h2></div></div>
      <div class="project-grid">{projects.map((project) => <article class="project-card">
        <p class="eyebrow">{project.status || 'Project'}</p><h3>{project.title}</h3><p>{project.summary}</p>
        <div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
        <div class="project-links">{project.url && <a href={project.url} target="_blank" rel="noreferrer">Visit project ↗</a>}{project.repoUrl && <a href={project.repoUrl} target="_blank" rel="noreferrer">Source ↗</a>}</div>
      </article>)}</div>
    </div>
  </section>}

  <section class="section shell" id="activity">
    <div class="section-heading"><div><p class="eyebrow">{projects.length ? '04' : '03'} / Activity</p><h2>Practice leaves<br /><em>a trace.</em></h2></div><p class="section-note">Build-time snapshots keep the page fast and protect account tokens.</p></div>
    <div class="activity-grid"><ActivityHeatmap source={activityData.github} label="GitHub" />{activityData.leetcode && <ActivityHeatmap source={activityData.leetcode} label="LeetCode" />}</div>
  </section>

  {notes.length > 0 && <section class="band section">
    <div class="shell"><div class="section-heading"><div><p class="eyebrow">Latest notes</p><h2>Ideas still<br /><em>in motion.</em></h2></div><a class="text-link" href={withBase('/notes/')}>Browse the garden ↗</a></div>
      <div class="home-notes">{notes.map((note) => <article><time datetime={note.date}>{note.date}</time><h3><a href={withBase(`/notes/${note.slug}/`)}>{note.title} ↗</a></h3><p>{note.description}</p></article>)}</div>
    </div>
  </section>}

  <section class="section shell playground-section">
    <div class="section-heading"><div><p class="eyebrow">Sticker playground</p><h2>A little room<br /><em>for gravity.</em></h2></div><p class="section-note">Drag, toss, and pin the pieces. Your arrangement stays in this browser.</p></div>
    <StickerPlayground stickers={stickerItems} client:visible />
  </section>

  {gallery.length > 0 && <section class="band section"><div class="shell">
    <div class="section-heading"><div><p class="eyebrow">Recent frames</p><h2>Small moments,<br /><em>kept close.</em></h2></div><a class="text-link" href={withBase('/gallery/')}>Open the gallery ↗</a></div>
    <div class="gallery-preview">{gallery.slice(0, 4).map((photo) => <img src={withBase(photo.thumbnail)} alt={photo.alt} loading="lazy" />)}</div>
  </div></section>}

  <section class="band section">
    <div class="shell section-grid">
      <p class="eyebrow">Beyond code</p>
      <div><h2 class="section-title">Keeping a life<br /><em>wide open.</em></h2><p class="body-large">I live in Shenzhen and make the long journey to school in Hong Kong. I swim, read, watch films, dramas, and animation, and follow curiosity wherever it leads.</p><p class="body-copy">Japanese came into my life through animation. Cantonese is the next language I want to grow into. Different interests do not always need to become a career plan; sometimes they simply make the person doing the work more awake.</p></div>
    </div>
  </section>

  <section class="section shell" style="text-align:center">
    <p class="eyebrow">A conversation starts small</p>
    <h2 class="section-title">Have an idea worth<br /><em>thinking through?</em></h2>
    <a class="button-primary" href={`mailto:${siteConfig.email}`}>Say hello ↗</a>
  </section>
</BaseLayout>
