---
import { siteConfig, withBase } from '../config/site.js'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const { title = siteConfig.title, description = siteConfig.description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ed" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-shell" aria-label="Main navigation">
        <a class="brand-mark" href={withBase('/')}>26068705g<span>.</span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
          <span></span><span></span>
        </button>
        <div class="desktop-nav">
          <a href={withBase('/#about')}>About</a>
          <a href={withBase('/#craft')}>Work</a>
          <a href={withBase('/notes/')}>Notes</a>
          <a href={withBase('/gallery/')}>Gallery</a>
          <a class="contact-link" href={`mailto:${siteConfig.email}`}>Get in touch ↗</a>
        </div>
      </nav>
      <div id="mobile-menu" class="mobile-menu" hidden>
        <a href={withBase('/#about')}>About</a>
        <a href={withBase('/#craft')}>Work</a>
        <a href={withBase('/notes/')}>Notes</a>
        <a href={withBase('/gallery/')}>Gallery</a>
        <a href={`mailto:${siteConfig.email}`}>Get in touch</a>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="footer-shell">
        <span>© <span data-current-year></span> 26068705g</span>
        <span>Learning in public, one small step at a time.</span>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('.menu-toggle')
      const menu = document.querySelector('#mobile-menu')
      toggle?.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true'
        toggle.setAttribute('aria-expanded', String(!isOpen))
        if (menu instanceof HTMLElement) menu.hidden = isOpen
      })
      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          toggle?.setAttribute('aria-expanded', 'false')
          if (menu instanceof HTMLElement) menu.hidden = true
        })
      })
      const year = document.querySelector('[data-current-year]')
      if (year) year.textContent = String(new Date().getFullYear())
    </script>
  </body>
</html>
